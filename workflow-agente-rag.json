    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Unifica las dos fuentes (webhook y Gmail) en un mismo esquema.\nconst j = $json;\nlet canal, pregunta, email, nombre;\nif (j.body) {                       // Webhook: { nombre, email, pregunta }\n  canal = 'webhook';\n  pregunta = j.body.pregunta;\n  email = j.body.email;\n  nombre = j.body.nombre;\n} else {                            // Gmail Trigger\n  canal = 'gmail';\n  const from = (j.from && j.from.text) || j.From || '';\n  const m = String(from).match(/<([^>]+)>/);\n  email = m ? m[1] : String(from).trim();\n  nombre = String(from).replace(/<.*>/, '').replace(/\"/g, '').trim();\n  pregunta = j.text || j.snippet || '';\n}\npregunta = String(pregunta || '').replace(/\\s+/g, ' ').trim().slice(0, 1000);\nemail = String(email || '').trim().toLowerCase();\nconst valida = pregunta.length >= 8 && /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email);\nreturn { json: { canal, nombre: nombre || '', email, pregunta, valida } };"
      },
