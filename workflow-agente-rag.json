    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Arma el texto + los metadatos que se guardan con cada fragmento.\nconst f = $('Loop Over Items').first().json;\nconst m = String(f.name || '').match(/^(ISL|SPP|AYU)/i);\nreturn { json: {\n  text: $json.text || '',\n  nombre_archivo: f.name,\n  tipo_documento: m ? m[1].toUpperCase() : 'OTRO',\n  file_id: f.id\n} };"
      },
