    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Guardrail previo a ejecutar cualquier acción sobre datos reales.\nconst base = $('Normalizar entrada').item.json;\nconst out = $json.output;\nconst validas = ['RESPONDER', 'PEDIR_ACLARACION', 'ESCALAR', 'FUERA_DE_ALCANCE'];\nlet r = { accion: 'ESCALAR', respuesta: '', documentos_citados: [], confianza: 'BAJA', motivo: '' };\n\nif ($json.error) {                              // salida de error del agente (API caída, timeout del Vector Store, etc.)\n  const e = $json.error;\n  r.motivo = 'Fallo del agente o del Vector Store: ' + (typeof e === 'string' ? e : (e.message || 'sin detalle'));\n} else if (!out || typeof out !== 'object') {   // respuesta nula del LLM\n  r.motivo = 'Respuesta nula o no parseable del LLM';\n} else if (!validas.includes(out.accion)) {\n  r.motivo = 'Acción inválida devuelta por el LLM: ' + out.accion;\n} else if (!out.respuesta || String(out.respuesta).trim().length < 5) {\n  r.motivo = 'Respuesta vacía del LLM';\n} else {\n  r = {\n    accion: out.accion,\n    respuesta: String(out.respuesta).trim().slice(0, 3000),\n    documentos_citados: Array.isArray(out.documentos_citados) ? out.documentos_citados : [],\n    confianza: ['ALTA', 'MEDIA', 'BAJA'].includes(out.confianza) ? out.confianza : 'BAJA',\n    motivo: out.motivo_escalamiento || ''\n  };\n  // Anti-alucinación: no se responde sin fuente o con confianza baja\n  if (r.accion === 'RESPONDER' && (r.documentos_citados.length === 0 || r.confianza === 'BAJA')) {\n    r.accion = 'ESCALAR';\n    r.motivo = 'Guardrail: respuesta sin fuente citada o con confianza baja';\n  }\n}\nif (r.accion === 'ESCALAR' && !r.motivo) r.motivo = 'Derivado por el agente';\n\nconst esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nr.respuesta_html = esc(r.respuesta).replace(/\\n/g, '<br>');\nr.fuentes_html = r.documentos_citados.map(d => '<li>' + esc(d) + '</li>').join('');\nreturn { json: { ...base, ...r } };"
      },
